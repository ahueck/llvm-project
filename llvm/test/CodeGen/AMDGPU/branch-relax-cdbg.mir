  bb.0:
    successors: %bb.1, %bb.2

    S_CBRANCH_CDBGUSER %bb.2

  bb.1:
    successors: %bb.2

    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0

  bb.2:
    S_ENDPGM 0
...

