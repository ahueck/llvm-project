## AMDGPU ELF identity fields are preserved in the output header.

# RUN: yaml2obj %p/Inputs/gfx1031.dwo.yaml -o %t.gfx1031.dwo
# RUN: llvm-dwp %t.gfx1031.dwo -o %t.dwp
# RUN: llvm-readobj --file-headers %t.dwp | FileCheck %s

# CHECK:      OS/ABI: AMDGPU_HSA
# CHECK:      ABIVersion: 3
# CHECK:      Machine: EM_AMDGPU
# CHECK:      Flags [
# CHECK-NEXT:   EF_AMDGPU_MACH_AMDGCN_GFX1031
