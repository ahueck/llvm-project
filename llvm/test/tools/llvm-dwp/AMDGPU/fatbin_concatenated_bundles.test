## --split-by-arch -e should recurse through every HIP offload bundle when a
## linked .hip_fatbin contains multiple concatenated bundle blobs.

# RUN: rm -rf %t
# RUN: mkdir %t
# RUN: yaml2obj %p/Inputs/host.dwo.yaml -o %t/host.dwo
# RUN: yaml2obj %p/Inputs/gfx1031.dwo.yaml -o %t/gfx1031.dwo
# RUN: yaml2obj %p/Inputs/gfx90a.dwo.yaml -o %t/gfx90a.dwo
# RUN: yaml2obj %p/Inputs/gfx1031-second.dwo.yaml -o %t/gfx1031-second.dwo
# RUN: yaml2obj %p/Inputs/gfx90a-second.dwo.yaml -o %t/gfx90a-second.dwo
# RUN: yaml2obj %p/Inputs/host-exec-skeleton.yaml -o %t/host.exe
# RUN: yaml2obj %p/Inputs/gfx1031-code-object-skeleton.yaml -o %t/gfx1031.co
# RUN: yaml2obj %p/Inputs/gfx90a-code-object-skeleton.yaml -o %t/gfx90a.co
# RUN: yaml2obj %p/Inputs/gfx1031-second-code-object-skeleton.yaml -o %t/gfx1031-second.co
# RUN: yaml2obj %p/Inputs/gfx90a-second-code-object-skeleton.yaml -o %t/gfx90a-second.co
# RUN: llvm-mc -triple=amdgcn-amd-amdhsa -filetype=obj -I %t \
# RUN:   %p/Inputs/make-concatenated-offload-bundles.s -o %t/fatbin.o
# RUN: llvm-objcopy --dump-section=.hip_fatbin=%t/fatbin %t/fatbin.o
# RUN: llvm-objcopy --add-section=.hip_fatbin=%t/fatbin %t/host.exe %t/host.unaligned
# RUN: llvm-objcopy --set-section-alignment=.hip_fatbin=4096 %t/host.unaligned %t/host.fat

# RUN: llvm-readobj --offloading %t/host.fat | FileCheck %s --check-prefix=OFFLOAD

# RUN: cd %t && llvm-dwp --split-by-arch -e host.fat -o out.dwp
# RUN: llvm-readobj --file-headers %t/out.dwp | FileCheck %s --check-prefix=HOST
# RUN: llvm-readobj --file-headers %t/out.gfx1031.dwp | FileCheck %s --check-prefix=GFX1031
# RUN: llvm-readobj --file-headers %t/out.gfx90a.dwp | FileCheck %s --check-prefix=GFX90A
# RUN: llvm-dwarfdump -debug-cu-index %t/out.dwp | FileCheck %s --check-prefix=HOST-CU
# RUN: llvm-dwarfdump -debug-cu-index %t/out.gfx1031.dwp | FileCheck %s --check-prefix=GPU-CU
# RUN: llvm-dwarfdump -debug-cu-index %t/out.gfx90a.dwp | FileCheck %s --check-prefix=GPU-CU

# OFFLOAD:      host-x86_64-unknown-linux-gnu-
# OFFLOAD-NEXT: hipv4-amdgcn-amd-amdhsa--gfx1031
# OFFLOAD-NEXT: hipv4-amdgcn-amd-amdhsa--gfx90a
# OFFLOAD-NEXT: host-x86_64-unknown-linux-gnu-
# OFFLOAD-NEXT: hipv4-amdgcn-amd-amdhsa--gfx1031
# OFFLOAD-NEXT: hipv4-amdgcn-amd-amdhsa--gfx90a

# HOST: Machine: EM_X86_64
# HOST-CU: 0x0011223344556677

# GFX1031:      Machine: EM_AMDGPU
# GFX1031:      Flags [
# GFX1031-NEXT:   EF_AMDGPU_MACH_AMDGCN_GFX1031

# GFX90A:      Machine: EM_AMDGPU
# GFX90A:      Flags [
# GFX90A-NEXT:   EF_AMDGPU_MACH_AMDGCN_GFX90A

# GPU-CU-DAG: 0x00ffeeddccbbaa99
# GPU-CU-DAG: 0x1020304050607080
