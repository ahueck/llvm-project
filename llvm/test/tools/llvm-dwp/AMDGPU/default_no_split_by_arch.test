## Without --split-by-arch, mixed input keeps legacy single-output behavior.

# RUN: yaml2obj %p/Inputs/host.yaml -o %t.host.dwo
# RUN: yaml2obj %p/Inputs/gfx1031.yaml -o %t.gfx1031.dwo

# RUN: llvm-dwp %t.host.dwo %t.gfx1031.dwo -o %t.dwp
# RUN: llvm-readobj --file-headers %t.dwp | FileCheck %s
# RUN: not llvm-readobj --file-headers %t.gfx1031.dwp 2>&1

# CHECK: Machine: EM_X86_64
