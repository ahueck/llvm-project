# RUN: not llvm-readobj --file-headers %t/legacy.gfx90a.dwp 2>&1

# OFFLOAD-DAG: hipv4-amdgcn-amd-amdhsa--gfx1031
# OFFLOAD-DAG: hipv4-amdgcn-amd-amdhsa--gfx90a

# HOST: Machine: EM_X86_64
# HOST-CU: 0x0011223344556677

# GFX1031:      Machine: EM_AMDGPU
# GFX1031:      Flags [
# GFX1031-NEXT:   EF_AMDGPU_MACH_AMDGCN_GFX1031

# GFX90A:      Machine: EM_AMDGPU
# GFX90A:      Flags [
# GFX90A-NEXT:   EF_AMDGPU_MACH_AMDGCN_GFX90A

# GPU-CU: 0x00ffeeddccbbaa99
