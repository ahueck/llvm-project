# RUN: cd %t && llvm-dwp -e host.fat -o legacy.dwp
# RUN: llvm-readobj --file-headers %t/legacy.dwp | FileCheck %s --check-prefix=HOST
# RUN: llvm-dwarfdump -debug-cu-index %t/legacy.dwp | FileCheck %s --check-prefix=HOST-CU
